# Copy to .env and fill in what you use. Everything is optional for a local demo.

# --- Language models (any provider LangChain supports) ---
# Write models as provider:model. Without a key, ReliefNet uses its offline rules.
LLM_MODE=auto                             # auto | live | mock
MODEL_FAST=anthropic:claude-haiku-5-5     # Intake extraction, Field chat (high volume)
MODEL_SMART=anthropic:claude-sonnet-5-5   # Dedupe close calls, Learner, briefings, "why" answers
ANTHROPIC_API_KEY=
# Other providers, for example:
#   MODEL_FAST=openai:gpt-5-mini              OPENAI_API_KEY=...
#   MODEL_FAST=google_genai:gemini-2.5-flash  GOOGLE_API_KEY=...   (pip install ".[google]")
#   MODEL_FAST=ollama:llama3.1                local and free; no key (pip install ".[ollama]")
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings for the Dedupe agent ---
EMBED_MODE=auto               # auto (fastembed if installed) | fastembed | hash

# --- Sign-in ---
AUTH_MODE=dev                 # dev: pick a demo user | clerk: real accounts and organisations
# For AUTH_MODE=clerk (Clerk Dashboard > API keys / JWT):
CLERK_JWKS_URL=               # https://<your-frontend-api>/.well-known/jwks.json
CLERK_ISSUER=                 # https://<your-frontend-api>
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:8080
VITE_CLERK_PUBLISHABLE_KEY=   # also put this in frontend/.env for `npm run dev`

# --- Telegram field bot (create one with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DEFAULT_ORG=         # slug that receives public bot requests (default: first organisation by slug)
DEMO_SNAP_PINS=true           # a shared pin outside the town is moved to a random spot inside it; false for a real town

# --- Demo timings ---
LEASE_MS=8000
DISPATCH_WORK_MS=2000
LEARNER_INTERVAL_S=40
SHIFT_TIMES=08:00,20:00
TZ_OFFSET_MINUTES=330
DEFAULT_ORGS=redcross:Red Cross Ganga Nagar,local_ngo:Sahyog Local NGO
